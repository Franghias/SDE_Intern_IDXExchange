# Backend Environment Variables (Local Development)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=rets
DB_PORT=3306
PORT=5000

# Railway / Cloud Database (Optional override for local dev or deployment)
# MYSQL_URL=mysql://root:password@containers-us-west.railway.app:3306/railway
# MYSQL_PUBLIC_URL=mysql://root:password@proxy.railway.app:12345/railway

# LLM / Chatbot Configuration (OpenRouter)
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=cohere/north-mini-code:free

